# Copy to .env.local. Do not put real secrets in this file.

# Firebase client (required)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin JSON string (required in production for session cookies)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Enables /api/ai/goal-insights. The route returns 501 when this is unset.
OPENAI_API_KEY=

# Required in production. Session cookie writes accept this origin only.
# Example: https://motivatedotmeai.vercel.app
# For local `next start`, use http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Dev only. Never set this in production.
# ALLOW_DEV_SESSION=1
