rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isUnderSizeLimit() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Raster images only. SVG is excluded because it can carry script.
    function isRasterImage() {
      return request.resource != null
        && request.resource.contentType.matches('^image/(jpeg|png|webp|gif)$');
    }

    function canWriteImage(userId) {
      return isOwner(userId) && isUnderSizeLimit() && isRasterImage();
    }

    match /users/{userId}/profile/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if canWriteImage(userId);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/goals/{goalId}/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if canWriteImage(userId);
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/habits/{habitId}/{fileName} {
      allow read: if isOwner(userId);
      allow create, update: if canWriteImage(userId);
      allow delete: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
